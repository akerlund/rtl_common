CAPI=2:
name: "akerlund::memory_ram:1.0.0"
description: "Single-port and dual-port synchronous RAM primitives"

filesets:
  rtl:
    files:
      - rtl/ram_sdp.sv
      - rtl/ram_sdp2c.sv
      - rtl/ram_sdp_bw.sv
      - rtl/ram_sp.sv
      - rtl/ram_sp_bw.sv
      - rtl/ram_tdp.sv
      - rtl/ram_tdp_bw.sv
    file_type: systemVerilogSource

targets:
  default:
    filesets:
      - rtl

  rtl:
    flow: lint
    flow_options:
      tool: verilator
      verilator_options:
        - -Wall
        - -Wno-fatal
    filesets:
      - rtl
    toplevel: ram_sp
